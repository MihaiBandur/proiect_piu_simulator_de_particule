// Diagrama ierarhiei de widget-uri: fereastra -> panouri -> widget-uri, cu layout-ul de la fiecare nivel.
// Generare: dot -Tpng ierarhie_widgeturi.dot -o capturi/ierarhie_widgeturi.png
digraph ierarhie_widgeturi {
    rankdir=LR;
    nodesep=0.25;
    ranksep=0.6;
    node [fontname="Helvetica", fontsize=11];
    edge [color="#888888", arrowsize=0.6];

    // widget-uri
    node [shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#2a6fdb"];
    mainWindow   [label="MainWindow\n(QMainWindow)"];
    menuBar      [label="QMenuBar\nFile · Edit · View · Help"];
    toolBar      [label="QToolBar"];
    central      [label="QWidget\n(central)"];
    statusBar    [label="QStatusBar"];
    runButton    [label="QToolButton\nRun (evidentiat)"];
    qubitLabel   [label="QLabel\n\"Qubiti:\""];
    qubitSpin    [label="QSpinBox\n1–5"];
    clearButton  [label="QToolButton\nGoleste circuitul"];
    paletteBox   [label="QGroupBox\nOperations"];
    circuitBox   [label="QGroupBox\nQ Circuit"];
    statsBox     [label="QGroupBox\nStatistics"];
    gatePalette  [label="GatePalette\n(QWidget propriu)"];
    singleTitle  [label="QLabel\n\"Porti pe un qubit\""];
    singleGates  [label="GateButton ×4\nH · X · Y · Z\n(QAbstractButton)"];
    ctrlTitle    [label="QLabel\n\"Porti controlate\""];
    ctrlGates    [label="GateButton\nCX"];
    measureTitle [label="QLabel\n\"Masurare\""];
    measureGates [label="GateButton\nM"];

    // panouri provizorii
    node [shape=box, style="rounded,filled,dashed", fillcolor="#eeeeee", color="#999999"];
    circuitView  [label="Zona de circuit\n(QWidget propriu – Matei)"];
    statsView    [label="Histograma / Tabel\n(QStackedWidget – Mihai)"];

    // layout-uri
    node [shape=ellipse, style=filled, fillcolor="#fff6dd", color="#e0a100", fontsize=10];
    rootLayout     [label="QHBoxLayout\nmargini 16, spatiere 16"];
    rightLayout    [label="QVBoxLayout\nspatiere 16"];
    paletteLayout  [label="QVBoxLayout\nmargini 8"];
    circuitLayout  [label="QVBoxLayout\nmargini 8"];
    statsLayout    [label="QVBoxLayout\nmargini 8"];
    groupsLayout   [label="QVBoxLayout\nspatiere 16 intre grupuri"];
    singleLayout   [label="QVBoxLayout\nspatiere 8"];
    singleGrid     [label="QGridLayout\n2 coloane"];
    ctrlLayout     [label="QVBoxLayout\nspatiere 8"];
    ctrlGrid       [label="QGridLayout"];
    measureLayout  [label="QVBoxLayout\nspatiere 8"];
    measureGrid    [label="QGridLayout"];

    mainWindow -> {menuBar toolBar central statusBar};
    toolBar -> {runButton qubitLabel qubitSpin clearButton};

    central -> rootLayout;
    rootLayout -> {paletteBox rightLayout};
    rightLayout -> {circuitBox statsBox};

    paletteBox -> paletteLayout -> gatePalette -> groupsLayout;
    circuitBox -> circuitLayout -> circuitView;
    statsBox -> statsLayout -> statsView;

    groupsLayout -> {singleLayout ctrlLayout measureLayout};
    singleLayout -> singleTitle;
    singleLayout -> singleGrid -> singleGates;
    ctrlLayout -> ctrlTitle;
    ctrlLayout -> ctrlGrid -> ctrlGates;
    measureLayout -> measureTitle;
    measureLayout -> measureGrid -> measureGates;
}
